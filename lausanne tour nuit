/* ════════════════════════════════════════════════════
   TOUR PARSING
════════════════════════════════════════════════════ */
function parseTour(txt){
  const found=new Set();
  txt.split(/\n/).forEach(line=>{
    if(!line.trim()) return;
    const nums=[...line.matchAll(/\b(\d{1,3})\b/g)].map(m=>parseInt(m[1]));
    // Take last valid stop ID on each line
    for(let i=nums.length-1;i>=0;i--){
      if(VIDS.has(nums[i])){ found.add(nums[i]); break; }
    }
  });
  return [...found].sort((a,b)=>a-b);
}
function onTourInput(){
  const ids=parseTour(this.value||document.getElementById('ta-tour').value);
  const box=document.getElementById('dbox-tour');
  const tags=document.getElementById('dtags-tour');
  if(!ids.length){ box.classList.remove('show'); return; }
  box.classList.add('show');
  tags.innerHTML=ids.map(id=>{
    const sp=special.has(id);
    return '<span class="dtag">'+id+'</span>'+(sp?'<span class="dtag-sp">K/V</span>':'');
  }).join('');
}
function confirmTour(){
  const txt=document.getElementById('ta-tour').value.trim();
  if(!txt){ toast('Colle d\'abord la liste des stops'); return; }
  const ids=parseTour(txt);
  if(!ids.length){ toast('Aucun stop valide détecté'); return; }
  ids.forEach(id=>tourStops.add(id));
  badge();
  saveState();
  const sp=ids.filter(id=>special.has(id)).length;
  toast(ids.length+' stop(s) ajouté(s)'+(sp?' · '+sp+' spéciaux':''));
  document.getElementById('ta-tour').value='';
  document.getElementById('dbox-tour').classList.remove('show');
  go('tour');
}
function clearTour(){
  document.getElementById('ta-tour').value='';
  document.getElementById('dbox-tour').classList.remove('show');
}
let _newTourPending=false,_newTourTimer;
function newTour(){
  if(!_newTourPending){
    _newTourPending=true;
    toast('⚠️ Appuyer encore pour confirmer');
    _newTourTimer=setTimeout(()=>{_newTourPending=false;},3000);
    return;
  }
  clearTimeout(_newTourTimer);_newTourPending=false;
  tourStops.clear();dat={};done.clear();
  badge();saveState();renderTourIfOpen();
  toast('✓ Nouvelle tournée prête');
}
function badge(){
  document.getElementById('b-stops').textContent=allIds().length+' stops';
  let ti=0,tk=0,tv=0;
  allIds().forEach(id=>{
    const d=dat[id]; if(!d||d.kp) return;
    ti+=d.i||0; tk+=d.k||0; tv+=d.v||0;
  });
  document.getElementById('b-i').textContent='i'+ti;
  document.getElementById('b-k').textContent='k'+tk;
  document.getElementById('b-v').textContent='v'+tv;
}
function renderTourIfOpen(){
  if(document.getElementById('pg-tour').classList.contains('on')) renderTour();
}

