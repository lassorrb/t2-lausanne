════════════════════════════════════════════════════ */
function renderTour(){
  const stops=allStops();
  const pending=stops.filter(s=>!done.has(s.id));
  document.getElementById('tour-lbl').textContent=stops.length+' stop(s) aujourd\'hui';

  // Banner + button state
  const banner=document.getElementById('done-banner');
  const btnNext=document.getElementById('btn-next');
  if(stops.length>0&&pending.length===0){
    banner.classList.add('show');
    btnNext.textContent='→ Résumé'; btnNext.className='btn bi';
  } else {
    banner.classList.remove('show');
    btnNext.textContent='Suivant →'; btnNext.className='btn ba';
  }

  const rc=document.getElementById('rcards');
  if(!stops.length){
    rc.innerHTML='<div class="empty">Aucun stop.<br>← Retour à Config.</div>';
    return;
  }
  rc.innerHTML='';
  const fp=stops.findIndex(s=>!done.has(s.id));

  stops.forEach((s,idx)=>{
    const isDone=done.has(s.id);
    const isCur=idx===fp;
    const d=D(s.id);
    const both=inBoth(s.id);
    const spOnly=inSpOnly(s.id);
    const showKV=hasKV(s.id);
    const showI=!spOnly; // IDEXX counter only if stop is in IDEXX tour

    // Card class
    let cc='rcard';
    if(isDone)      cc+=' card-done';
    else if(d.kp)   cc+=' card-kp';
    else if(isCur)  cc+=' cur';
    if(!isDone&&!d.kp){
      if(both)   cc+=' card-blue';
      else if(spOnly) cc+=' card-yellow';
    }

    // Status tags
    let tags='';
    if(d.kp){
      tags='<span class="stag st-kp">KP</span>';
    } else {
      const ti=d.i||0,tk=d.k||0,tv=d.v||0,tg=d.gp||0;
      const tot=ti+tk+tv;
      if(tot===0&&tg===0){
        tags=spOnly
          ?'<span class="stag st-sp">K/V</span>'
          :'<span class="stag st-z">—</span>';
      } else {
        if(ti>0) tags+='<span class="stag st-i">i'+ti+'</span>';
        if(tk>0) tags+='<span class="stag st-k">k'+tk+'</span>';
        if(tv>0) tags+='<span class="stag st-v">v'+tv+'</span>';
        if(tg>0) tags+='<span class="stag st-gp">'+tg+'GP</span>';
      }
    }
    const dis=d.kp?' dis':'';

    // Lab rows
    const rowI=showI?'<div class="lrow'+dis+'"><div class="lic li-i">I</div><div class="lnm"><span>idexx</span><b class="ci">Labor I</b></div><button class="cbtn" onclick="chg('+s.id+',\'i\',-1)">−</button><div class="cval cv-i'+((d.i||0)===0?' z':'')+'">'+( d.i||0)+'</div><button class="cbtn" onclick="chg('+s.id+',\'i\',1)">+</button></div>':'';
    const rowK=showKV?'<div class="lrow'+dis+'"><div class="lic li-k">K</div><div class="lnm"><span>kühne</span><b class="ck">Kühne Pathologie</b></div><button class="cbtn" onclick="chg('+s.id+',\'k\',-1)">−</button><div class="cval cv-k'+((d.k||0)===0?' z':'')+'">'+( d.k||0)+'</div><button class="cbtn" onclick="chg('+s.id+',\'k\',1)">+</button></div>':'';
    const rowV=showKV?'<div class="lrow'+dis+'"><div class="lic li-v">V</div><div class="lnm"><span>labvets</span><b class="cv">LaborVets</b></div><button class="cbtn" onclick="chg('+s.id+',\'v\',-1)">−</button><div class="cval cv-v'+((d.v||0)===0?' z':'')+'">'+( d.v||0)+'</div><button class="cbtn" onclick="chg('+s.id+',\'v\',1)">+</button></div>':'';
    const rowGP='<div class="lrow'+dis+'"><div class="lic li-gp">❄️</div><div class="lnm"><span>gefrost</span><b class="ca">Probe GP</b></div><button class="cbtn" onclick="chg('+s.id+',\'gp\',-1)">−</button><div class="cval cv-gp'+((d.gp||0)===0?' z':'')+'">'+( d.gp||0)+'</div><button class="cbtn" onclick="chg('+s.id+',\'gp\',1)">+</button></div>';
    const rowKP='<button class="kp-btn'+(d.kp?' on':'')+'" onclick="togKP('+s.id+')">KP — Keine Probe</button>';

    const noteHtml=s.note?'<div class="rc-addr" style="color:var(--a)">💡 '+s.note.slice(0,55)+(s.note.length>55?'…':'')+'</div>':'';

    const card=document.createElement('div');
    card.className=cc; card.id='rc-'+s.id;
    card.innerHTML=
      '<div class="rc-top">'
      +'<button class="rc-gps" onclick="gmStop('+s.id+')">'
      +'<span class="rc-gps-n">'+s.id+'</span>'
      +'<span class="rc-gps-ico">🗺</span>'
      +'</button>'
      +'<div class="rc-info" onclick="openMo('+s.id+')">'
      +'<div class="rc-name">'+s.n+'</div>'
      +'<div class="rc-addr">'+s.a+'</div>'
      +noteHtml
      +'<div class="rc-stags">'+tags+'</div>'
      +'</div>'
      +'<div class="rc-right">'
      +'<div class="dring'+(isDone?' on':'')+'" onclick="togDone('+s.id+')"></div>'
      +'</div>'
      +'</div>'
      +'<div class="ep'+(isDone?'':' open')+'">'
      +'<button class="gps-btn" onclick="gmStop('+s.id+')">🗺 Naviguer vers ce stop</button>'
      +rowI+rowK+rowV+rowGP+rowKP
      +'</div>';
    rc.appendChild(card);
  });
}

/* ════════════════════════════════════════════════════
   SAISIE
════════════════════════════════════════════════════ */
function chg(id,lab,delta){
  const d=D(id); if(d.kp) return;
  d[lab]=Math.max(0,(d[lab]||0)+delta);
  saveState(); badge(); renderTour();
}
function togKP(id){
  const d=D(id); d.kp=!d.kp;
  if(d.kp){ d.i=0; d.k=0; d.v=0; d.gp=0; }
  saveState(); badge(); renderTour();
}
function togDone(id){
  done.has(id)?done.delete(id):done.add(id);
  saveState(); badge(); renderTour();
}

/* ════════════════════════════════════════════════════
   GPS
════════════════════════════════════════════════════ */
function fixA(a){
  return a.replace(/ü/g,'ue').replace(/Ü/g,'Ue')
          .replace(/ä/g,'ae').replace(/Ä/g,'Ae')
          .replace(/ö/g,'oe').replace(/Ö/g,'Oe')
          .replace(/é/g,'e').replace(/è/g,'e')
          .replace(/ê/g,'e').replace(/à/g,'a')
          .replace(/â/g,'a').replace(/[–—]/g,'-');
}
function openGM(addr){
  window.open('https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(fixA(addr)));
}
function gmStop(id){ const s=SM[id]; if(!s) return; openGM(s.a); toast('🗺 Stop #'+id); }
function mapsAll(){
  const stops=allStops().filter(s=>!done.has(s.id));
  if(!stops.length){ toast('Tous les stops sont faits !'); return; }
  if(stops.length===1){ openGM(stops[0].a); return; }
  const dest=encodeURIComponent(fixA(stops[stops.length-1].a));
  const wp=stops.slice(0,-1).map(s=>encodeURIComponent(fixA(s.a))).join('|');
  window.open('https://www.google.com/maps/dir/?api=1&destination='+dest+'&waypoints='+wp+'&travelmode=driving');
}

/* ════════════════════════════════════════════════════
   MODAL
════════════════════════════════════════════════════ */
function openMo(id){
  const s=SM[id]; const sp=special.has(id);
  document.getElementById('mo-id').textContent='#'+s.id;
  document.getElementById('mo-nm').textContent=s.n;
  document.getElementById('mo-ad').textContent=s.a;
  const ne=document.getElementById('mo-note');
  if(s.note){ ne.textContent=s.note; ne.style.display=''; }
  else ne.style.display='none';
  document.getElementById('mo-sp-badge').style.display=sp?'':'none';
  document.getElementById('mo-gps').onclick=()=>openGM(s.a);
  document.getElementById('mo-del').onclick=()=>{
    tourStops.delete(id); special.delete(id);
    delete dat[id]; done.delete(id);
    syncGrid(); renderChips(); saveSpecial();
    badge(); saveState(); closeMo(); renderTour();
    toast('Stop #'+id+' supprimé');
  };
  document.getElementById('mbg').classList.add('open');
}
function closeMo(){ document.getElementById('mbg').classList.remove('open'); }
document.getElementById('mbg').addEventListener('click',e=>{ if(e.target.id==='mbg') closeMo(); });

/* ════════════════════════════════════════════════════
   WHATSAPP FORMAT
   gp1, gp2, gp3 — number after "gp"
   Auto-KP if nothing entered
════════════════════════════════════════════════════ */
function waLine(s){
  const d=dat[s.id]||{i:0,k:0,v:0,gp:0,kp:false};
  if(d.kp) return s.id+'/kp';
  const p=[];
  const showI=!inSpOnly(s.id);
  if(showI&&(d.i||0)>0) p.push('i'+d.i);
  if((d.k||0)>0) p.push('k'+d.k);
  if((d.v||0)>0) p.push('v'+d.v);
  if((d.gp||0)>0) p.push('gp'+(d.gp||0));
  if(!p.length) return s.id+'/kp'; // auto-kp
  return s.id+'/'+p.join('/');
}
function waText(){ return allStops().map(s=>waLine(s)).join('\n'); }

/* WA color class */
function waClass(s){
  const d=dat[s.id]||{i:0,k:0,v:0,gp:0,kp:false};
  if(d.kp) return 'wkp';
  const showI=!inSpOnly(s.id);
  const hasI=(d.i||0)>0 && showI;
  const hasK=(d.k||0)>0;
  const hasV=(d.v||0)>0;
  const hasGP=(d.gp||0)>0;
  // Rien → auto-kp rouge
  if(!hasI&&!hasK&&!hasV&&!hasGP) return 'wkp';
  // K ou V avec IDEXX → bleu
  if(hasI&&(hasK||hasV)) return 'wb';
  // K ou V sans IDEXX → jaune
  if(!hasI&&(hasK||hasV)) return 'wy';
  // Tout le reste (IDEXX seul, GP seul, IDEXX+GP) → vert
  return 'wn';
}

/* ════════════════════════════════════════════════════
   RÉSUMÉ
════════════════════════════════════════════════════ */
function renderSum(){
  const stops=allStops();
  let ti=0,tk=0,tv=0,tg=0;
  stops.forEach(s=>{
    const d=dat[s.id]||{}; if(d.kp) return;
    ti+=d.i||0; tk+=d.k||0; tv+=d.v||0; tg+=d.gp||0;
  });
  document.getElementById('sum-total').textContent=ti+tk+tv+tg;
  const bd=document.getElementById('sum-bd'); bd.innerHTML='';
  if(ti>0) bd.innerHTML+='<span class="sbd sbd-i">i'+ti+'</span>';
  if(tk>0) bd.innerHTML+='<span class="sbd sbd-k">k'+tk+'</span>';
  if(tv>0) bd.innerHTML+='<span class="sbd sbd-v">v'+tv+'</span>';
  if(tg>0) bd.innerHTML+='<span class="sbd sbd-gp">'+tg+'GP</span>';

  const now=new Date();
  document.getElementById('sum-date').textContent=
    now.toLocaleDateString('fr-CH',{weekday:'long',day:'numeric',month:'long',year:'numeric'});

  // WA preview
  const wb=document.getElementById('wa-box'); wb.innerHTML='';
  if(!stops.length){ wb.textContent='(aucun stop)'; return; }
  stops.forEach(s=>{
    const div=document.createElement('div');
    div.className=waClass(s);
    div.textContent=waLine(s);
    wb.appendChild(div);
  });

  // Detail
  const dl=document.getElementById('det-list'); dl.innerHTML='';
  stops.forEach(s=>{
    const d=dat[s.id]||{i:0,k:0,v:0,gp:0,kp:false};
    const showI=!inSpOnly(s.id);
    const isKP=d.kp||(!showI?!(d.k||d.v||d.gp):!(d.i||d.k||d.v||d.gp));
    let tags='';
    if(isKP){ tags='<span class="stag st-kp">KP</span>'; }
    else {
      if(showI&&(d.i||0)>0) tags+='<span class="stag st-i">i'+d.i+'</span>';
      if((d.k||0)>0) tags+='<span class="stag st-k">k'+d.k+'</span>';
      if((d.v||0)>0) tags+='<span class="stag st-v">v'+d.v+'</span>';
      if((d.gp||0)>0) tags+='<span class="stag st-gp">'+d.gp+'GP</span>';
      if(!tags) tags='<span class="stag st-kp">KP</span>';
    }
    const row=document.createElement('div'); row.className='det-row';
    row.innerHTML='<div class="dr-id">'+s.id+'</div><div class="dr-nm">'+s.n+'</div><div class="dr-tags">'+tags+'</div>';
    dl.appendChild(row);
  });
}

function copyWA(){
  const txt=waText();
  const fb=()=>{
    const ta=document.createElement('textarea');
    ta.value=txt; ta.style.cssText='position:fixed;opacity:0;top:0;left:0';
    document.body.appendChild(ta); ta.focus(); ta.select();
    try{ document.execCommand('copy'); toast('✓ Copié !'); }
    catch(e){ toast('Copie manuelle requise'); }
    document.body.removeChild(ta);
  };
  if(navigator.clipboard&&navigator.clipboard.writeText)
    navigator.clipboard.writeText(txt).then(()=>toast('✓ Copié pour WhatsApp !')).catch(fb);
  else fb();
}

/* ════════════════════════════════════════════════════
   SAUVEGARDE / HISTORIQUE
════════════════════════════════════════════════════ */
function saveTour(){
  const stops=allStops();
  if(!stops.length){ toast('Rien à sauvegarder'); return; }
  let ti=0,tk=0,tv=0,tg=0;
  stops.forEach(s=>{const d=dat[s.id]||{};if(d.kp)return;ti+=d.i||0;tk+=d.k||0;tv+=d.v||0;tg+=d.gp||0;});
  const rec={
    date:new Date().toISOString(),
    wa:waText(),
    stops:stops.map(s=>({id:s.id,...(dat[s.id]||{})})),
    totals:{i:ti,k:tk,v:tv,gp:tg}
  };
  const hist=JSON.parse(localStorage.getItem('t2laushist')||'[]');
  hist.unshift(rec);
  localStorage.setItem('t2laushist',JSON.stringify(hist.slice(0,30)));
  // Reset daily state
  tourStops.clear(); dat={}; done.clear();
  badge(); saveState();
  go('hist');
  toast('Tournée sauvegardée ✓');
}

function renderHist(){
  const hist=JSON.parse(localStorage.getItem('t2laushist')||'[]');
  const el=document.getElementById('hist-list');
  if(!hist.length){ el.innerHTML='<div class="empty">Aucune tournée sauvegardée.</div>'; return; }
  el.innerHTML='';
  hist.forEach(h=>{
    const d=new Date(h.date);
    const ds=d.toLocaleDateString('fr-CH',{weekday:'short',day:'numeric',month:'short',year:'numeric'})
             +' '+d.toLocaleTimeString('fr-CH',{hour:'2-digit',minute:'2-digit'});
    const t=h.totals||{i:0,k:0,v:0,gp:0};
    const c=document.createElement('div'); c.className='hcard';
    c.innerHTML=
      '<div class="hd">'+ds+'</div>'
      +'<div class="hstats">'
      +'<div class="hs"><b>'+h.stops.length+'</b> stops</div>'
      +'<div class="hs hsi"><b>'+(t.i||0)+'</b> i</div>'
      +'<div class="hs hsk"><b>'+(t.k||0)+'</b> k</div>'
      +'<div class="hs hsv"><b>'+(t.v||0)+'</b> v</div>'
      +'</div>'
      +'<div class="hwa">'+(h.wa||'').replace(/\n/g,'<br>')+'</div>';
    el.appendChild(c);
  });
}

let _chPend=false,_chTimer;
function clearHist(){
  if(!_chPend){_chPend=true;toast('⚠️ Appuyer encore pour effacer');_chTimer=setTimeout(()=>{_chPend=false;},3000);return;}
  clearTimeout(_chTimer);_chPend=false;
  localStorage.removeItem('t2laushist');
  renderHist();
  toast('Historique effacé');
}

/* ════════════════════════════════════════════════════
   PERSISTENCE
════════════════════════════════════════════════════ */
function saveSpecial(){
  localStorage.setItem('t2laussp',JSON.stringify([...special]));
}
function loadSpecial(){
  try{
    const s=JSON.parse(localStorage.getItem('t2laussp')||'[]');
    special=new Set(s.map(Number));
    syncGrid();
    renderChips();
  }catch(e){}
}
function saveState(){
  localStorage.setItem('t2lausstate',JSON.stringify({
    tour:[...tourStops], dat, done:[...done]
  }));
}
function loadState(){
  try{
    const s=JSON.parse(localStorage.getItem('t2lausstate')||'{}');
    if(s.tour) tourStops=new Set(s.tour);
    if(s.dat)  dat=s.dat;
    if(s.done) done=new Set(s.done);
    badge();
  }catch(e){}
}

/* ════════════════════════════════════════════════════
   TOAST
════════════════════════════════════════════════════ */
let _tt;
function toast(msg){
  const el=document.getElementById('toast');
  el.textContent=msg; el.classList.add('show');
  clearTimeout(_tt); _tt=setTimeout(()=>el.classList.remove('show'),2500);
}

/* START */
init();
</script>
