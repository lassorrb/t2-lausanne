  const pending=allStops().filter(s=>!done.has(s.id));
  if(!pending.length){ go('sum'); toast('✅ Tournée terminée !'); return; }
  openGM(pending[0].a);
  toast('🗺 Stop #'+pending[0].id);
}

/* ════════════════════════════════════════════════════
