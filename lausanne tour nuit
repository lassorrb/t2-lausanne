
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,user-scalable=yes,viewport-fit=cover"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<meta name="apple-mobile-web-app-title" content="T2 Lausanne"/>
<meta name="theme-color" content="#06060d"/>
<title>T2 Lausanne</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Unbounded:wght@700;900&display=swap" rel="stylesheet"/>
<style>
/* ── TOKENS ─────────────────────────────── */
:root{
  --bg:#06060d;--s1:#0c0c18;--s2:#111120;
  --rim:#1f1f35;--rim2:#2a2a45;
  --txt:#e0e0f0;--sub:#606080;--sub2:#38385a;
  --i:#00f090;--i1:rgba(0,240,144,.09);--i2:rgba(0,240,144,.22);
  --k:#00ccff;--k1:rgba(0,204,255,.09);--k2:rgba(0,204,255,.24);
  --v:#b06cff;--v1:rgba(176,108,255,.09);--v2:rgba(176,108,255,.24);
  --a:#ffb700;--a1:rgba(255,183,0,.09);--a2:rgba(255,183,0,.24);
  --r:#ff3355;--r1:rgba(255,51,85,.09);--r2:rgba(255,51,85,.24);
  --b:#4d8fff;--b1:rgba(77,143,255,.09);--b2:rgba(77,143,255,.24);
  --y:#f5c400;--y1:rgba(245,196,0,.09);--y2:rgba(245,196,0,.24);
  --rad:12px;--radL:16px;
  --st:env(safe-area-inset-top,0px);--sb:env(safe-area-inset-bottom,0px);
}
/* ── RESET ──────────────────────────────── */
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;background:var(--bg);color:var(--txt);font-family:'Space Grotesk',sans-serif;overscroll-behavior:none;-webkit-font-smoothing:antialiased}
button{border:none;cursor:pointer;font-family:inherit;touch-action:manipulation}
input,textarea{font-family:inherit;touch-action:manipulation}
#app{height:100%;display:flex;flex-direction:column;max-width:520px;margin:0 auto}

/* ── HEADER ─────────────────────────────── */
.hdr{padding:calc(var(--st)+11px) 14px 11px;background:var(--bg);border-bottom:1px solid var(--rim);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50}
.logo{font-family:'Unbounded',sans-serif;font-size:17px;font-weight:900;letter-spacing:-.3px}
.logo b{color:var(--i)}
.pills{display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end;max-width:60%}
.pill{padding:3px 9px;border-radius:20px;font-size:9px;font-weight:700;letter-spacing:.5px;border:1px solid;white-space:nowrap}
.pi{background:var(--i1);color:var(--i);border-color:var(--i2)}
.pk{background:var(--k1);color:var(--k);border-color:var(--k2)}
.pv{background:var(--v1);color:var(--v);border-color:var(--v2)}
.ps{background:var(--s2);color:var(--sub);border-color:var(--rim2)}

/* ── TABS ───────────────────────────────── */
.tabs{display:flex;background:var(--bg);border-bottom:1px solid var(--rim);padding:7px 10px;gap:5px}
.tab{flex:1;height:36px;border-radius:9px;border:1px solid var(--rim2);background:var(--s1);color:var(--sub);font-family:'Space Grotesk',sans-serif;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;transition:all .14s}
.tab.on{background:var(--i1);border-color:var(--i2);color:var(--i)}

/* ── SCREENS ────────────────────────────── */
.pg{display:none;flex:1;overflow-y:auto;padding:13px 12px;padding-bottom:calc(var(--sb)+30px)}
.pg.on{display:block}
.lbl{font-size:9px;letter-spacing:3px;color:var(--sub);text-transform:uppercase;margin:16px 0 8px}
.lbl:first-child{margin-top:0}
.hint{font-size:11px;color:var(--sub);line-height:1.6;margin-bottom:9px}
.empty{text-align:center;color:var(--sub);padding:48px 20px;font-size:13px;line-height:2}

/* ── BUTTONS ────────────────────────────── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:50px;padding:0 18px;border-radius:var(--rad);font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;letter-spacing:.2px;transition:all .12s;white-space:nowrap;border:1px solid transparent}
.btn:active{transform:scale(.93)}
.bi{background:var(--i);color:#000}
.bs{background:var(--s2);color:var(--txt);border-color:var(--rim2)}
.ba{background:var(--a1);color:var(--a);border-color:var(--a2)}
.br{background:var(--r1);color:var(--r);border-color:var(--r2)}
.by{background:var(--y);color:#000}
.bw{width:100%;display:flex}
.brow{display:flex;gap:8px;margin-bottom:8px}

/* ── TEXTAREA ───────────────────────────── */
.ta{width:100%;background:var(--s1);border:1px solid var(--rim2);border-radius:var(--radL);color:var(--txt);font-size:13px;padding:13px;outline:none;resize:none;line-height:1.75;transition:border-color .2s}
.ta:focus{border-color:var(--i2)}
.ta::placeholder{color:var(--sub2)}

/* ── DETECT BOX ─────────────────────────── */
.dbox{display:none;border-radius:var(--rad);padding:12px 14px;margin-top:9px}
.dbox.show{display:block}
.dbi{background:var(--i1);border:1px solid var(--i2)}
.dbox-ttl{font-size:9px;color:var(--i);letter-spacing:2.5px;text-transform:uppercase;margin-bottom:8px}
.dtags{display:flex;flex-wrap:wrap;gap:5px}
.dtag{background:var(--i);color:#000;border-radius:7px;padding:4px 10px;font-family:'Unbounded',sans-serif;font-size:13px;font-weight:700}
.dtag-sp{background:var(--y);color:#000;border-radius:7px;padding:3px 7px;font-size:10px;font-weight:700}

/* ── MANUAL ADD ROW ─────────────────────── */
.add-row{display:flex;gap:8px;margin-bottom:4px}
.ni{width:72px;height:50px;background:var(--s1);border:1px solid var(--rim2);border-radius:var(--rad);color:var(--txt);font-size:20px;font-weight:700;text-align:center;outline:none;transition:border-color .2s}
.ni:focus{border-color:var(--i2)}

/* ── TOUR 312 GRID ──────────────────────── */
.sp-grid{display:none;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:10px;margin-bottom:6px}
.sp-grid.open{display:grid}
.spg-btn{height:52px;border-radius:11px;border:1px solid var(--rim2);background:var(--s1);color:var(--sub);font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;transition:all .12s;display:flex;align-items:center;justify-content:center}
.spg-btn:active{transform:scale(.87)}
.spg-btn.on{background:var(--y);border-color:var(--y);color:#000;font-weight:900}

/* ── SAVED SP CHIPS ─────────────────────── */
.sp-chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px;min-height:24px}
.sp-chip{background:var(--s2);border:1px solid var(--y2);border-radius:9px;padding:5px 10px;font-size:12px;display:inline-flex;align-items:center;gap:5px}
.sp-chip-id{font-family:'Unbounded',sans-serif;font-size:13px;font-weight:900;color:var(--y)}
.sp-chip-k{font-size:9px;color:var(--k);font-weight:700}
.sp-chip-v{font-size:9px;color:var(--v);font-weight:700}
.sp-chip-x{color:var(--sub);font-size:15px;cursor:pointer;opacity:.7;line-height:1}
.sp-chip-x:active{opacity:1}

/* ── ROUTE CARDS ────────────────────────── */
.rcards{display:flex;flex-direction:column;gap:8px}
/* Base card */
.rcard{background:var(--s1);border:1px solid var(--rim2);border-radius:var(--radL);overflow:hidden;transition:border-color .2s}
/* Current */
.rcard.cur{border-color:var(--i)}
/* BLUE = both lists (IDEXX + special) */
.rcard.card-blue{border-color:var(--b2)}
.rcard.card-blue.cur{border-color:var(--b)}
/* YELLOW = special only */
.rcard.card-yellow{border-color:var(--y2)}
.rcard.card-yellow.cur{border-color:var(--y)}
/* KP override */
.rcard.card-kp{border-color:var(--r2)}
/* Done */
.rcard.card-done{opacity:.35}
.rcard.card-done .ep,.rcard.card-done .rc-gps,.rcard.card-done .rc-info,.rcard.card-done .rc-stags{pointer-events:none}

/* Card top row */
.rc-top{display:flex;align-items:stretch;min-height:70px}

/* GPS number button */
.rc-gps{width:60px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--i1);flex-shrink:0;border:none;transition:all .13s;gap:2px;padding:6px 0}
.rc-gps:active{background:var(--i);transform:scale(.94)}
.rcard.card-blue .rc-gps{background:var(--b1)}
.rcard.card-blue .rc-gps:active{background:var(--b)}
.rcard.card-yellow .rc-gps{background:var(--y1)}
.rcard.card-yellow .rc-gps:active{background:var(--y)}
.rcard.card-done .rc-gps{background:transparent}
.rcard.card-kp .rc-gps{background:var(--r1)}
.rc-gps-n{font-family:'Unbounded',sans-serif;font-size:20px;font-weight:900;color:var(--i);line-height:1}
.rcard.card-blue .rc-gps-n{color:var(--b)}
.rcard.card-yellow .rc-gps-n{color:var(--y)}
.rcard.card-done .rc-gps-n{color:var(--sub)}
.rcard.card-kp .rc-gps-n{color:var(--r)}
.rc-gps-ico{font-size:13px;opacity:.55}

/* Card info */
.rc-info{flex:1;padding:9px 11px;min-width:0;cursor:pointer;display:flex;flex-direction:column;justify-content:center}
.rc-name{font-size:11px;font-weight:700;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:2px}
.rc-addr{font-size:9px;color:var(--sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px}
.rc-stags{display:flex;gap:3px;flex-wrap:wrap}
.stag{font-family:'Unbounded',sans-serif;font-size:10px;font-weight:700;padding:2px 7px;border-radius:5px;border:1px solid;letter-spacing:.3px}
.st-i{background:var(--i1);color:var(--i);border-color:var(--i2)}
.st-k{background:var(--k1);color:var(--k);border-color:var(--k2)}
.st-v{background:var(--v1);color:var(--v);border-color:var(--v2)}
.st-gp{background:var(--a1);color:var(--a);border-color:var(--a2)}
.st-kp{background:var(--r1);color:var(--r);border-color:var(--r2)}
.st-sp{background:var(--y1);color:var(--y);border-color:var(--y2)}
.st-z{background:var(--s2);color:var(--sub);border-color:var(--rim2)}

/* Done ring */
.rc-right{display:flex;align-items:center;padding:0 10px;flex-shrink:0}
.dring{width:30px;height:30px;border-radius:50%;border:2px solid var(--rim2);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .14s;flex-shrink:0}
.dring.on{background:var(--i);border-color:var(--i)}
.dring.on::after{content:'✓';color:#000;font-size:14px;font-weight:900}

/* Entry panel */
.ep{border-top:1px solid var(--rim);padding:11px;display:none;flex-direction:column;gap:8px}
.ep.open{display:flex}

/* GPS btn inside panel */
.gps-btn{width:100%;height:42px;border-radius:10px;background:var(--i1);color:var(--i);border:1px solid var(--i2);font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:7px;transition:all .12s}
.gps-btn:active{background:var(--i);color:#000;transform:scale(.97)}

/* Lab counter rows */
.lrow{display:flex;align-items:center;gap:8px;background:var(--bg);border:1px solid var(--rim2);border-radius:11px;padding:7px 9px}
.lrow.dis{opacity:.3;pointer-events:none}
.lic{font-family:'Unbounded',sans-serif;font-size:17px;font-weight:900;width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:9px;border:1px solid;flex-shrink:0}
.li-i{background:var(--i1);color:var(--i);border-color:var(--i2)}
.li-k{background:var(--k1);color:var(--k);border-color:var(--k2)}
.li-v{background:var(--v1);color:var(--v);border-color:var(--v2)}
.li-gp{background:var(--a1);color:var(--a);border-color:var(--a2);font-size:13px}
.lnm{flex:1;min-width:0}
.lnm span{display:block;font-size:9px;color:var(--sub);letter-spacing:1px;text-transform:uppercase}
.lnm b{display:block;font-size:12px;color:var(--txt);font-weight:700}
.lnm b.ci{color:var(--i)}.lnm b.ck{color:var(--k)}.lnm b.cv{color:var(--v)}.lnm b.ca{color:var(--a)}
.cbtn{width:44px;height:44px;border-radius:11px;border:1px solid var(--rim2);background:var(--s1);color:var(--txt);font-family:'Unbounded',sans-serif;font-size:24px;display:flex;align-items:center;justify-content:center;transition:all .11s}
.cbtn:active{transform:scale(.82);background:var(--s2)}
.cval{font-family:'Unbounded',sans-serif;font-size:32px;font-weight:900;min-width:42px;text-align:center;line-height:1}
.cv-i{color:var(--i)}.cv-k{color:var(--k)}.cv-v{color:var(--v)}.cv-gp{color:var(--a)}
.cval.z{color:var(--sub)}

/* KP button */
.kp-btn{width:100%;height:48px;border-radius:11px;font-family:'Unbounded',sans-serif;font-size:17px;font-weight:700;border:1px solid var(--r2);background:var(--r1);color:var(--r);transition:all .12s;letter-spacing:1px}
.kp-btn:active{transform:scale(.93)}
.kp-btn.on{background:var(--r);color:#fff;border-color:var(--r)}

/* Map row */
.map-row{display:flex;gap:7px;margin-bottom:11px}

/* Done banner */
.done-banner{background:var(--i1);border:1px solid var(--i2);border-radius:var(--radL);padding:14px 16px;margin-bottom:12px;display:none;align-items:center;justify-content:space-between;gap:10px}
.done-banner.show{display:flex}
.db-txt{font-size:13px;font-weight:700;color:var(--i)}
.db-sub{font-size:10px;color:var(--sub);margin-top:2px}

/* ── SUMMARY ────────────────────────────── */
.sum-hero{background:var(--i1);border:1px solid var(--i2);border-radius:var(--radL);padding:20px;text-align:center;margin-bottom:13px}
.sum-n{font-family:'Unbounded',sans-serif;font-size:68px;font-weight:900;color:var(--i);line-height:1}
.sum-l{font-size:9px;color:var(--sub);letter-spacing:3px;text-transform:uppercase;margin-top:4px}
.sum-bd{display:flex;gap:6px;justify-content:center;margin-top:10px;flex-wrap:wrap}
.sbd{font-family:'Unbounded',sans-serif;font-size:13px;font-weight:700;padding:4px 10px;border-radius:7px;border:1px solid}
.sbd-i{background:var(--i1);color:var(--i);border-color:var(--i2)}
.sbd-k{background:var(--k1);color:var(--k);border-color:var(--k2)}
.sbd-v{background:var(--v1);color:var(--v);border-color:var(--v2)}
.sbd-gp{background:var(--a1);color:var(--a);border-color:var(--a2)}

/* Color legend */
.legend{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px;font-size:10px}
.legend span{display:flex;align-items:center;gap:4px}

/* WA preview */
.wa-box{background:var(--s1);border:1px solid var(--rim2);border-radius:var(--rad);padding:14px 16px;margin-bottom:11px;font-size:15px;line-height:2.1}
.wn{color:var(--i);font-weight:700}   /* IDEXX only */
.wb{color:var(--b);font-weight:700}   /* IDEXX + K/V */
.wy{color:var(--y);font-weight:700}   /* K/V only */
.wg{color:var(--a);font-weight:700}   /* has GP */
.wkp{color:var(--r);font-weight:700}  /* KP */

/* Detail rows */
.det-list{display:flex;flex-direction:column;gap:5px;margin-bottom:12px}
.det-row{display:flex;align-items:center;padding:10px 13px;background:var(--s1);border:1px solid var(--rim);border-radius:10px}
.dr-id{font-family:'Unbounded',sans-serif;font-size:20px;font-weight:900;color:var(--i);min-width:44px}
.dr-nm{flex:1;font-size:10px;padding:0 8px;color:var(--txt);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dr-tags{display:flex;gap:3px;flex-wrap:wrap;justify-content:flex-end}

/* History */
.hcard{background:var(--s1);border:1px solid var(--rim2);border-radius:var(--radL);padding:13px;margin-bottom:7px}
.hd{font-size:9px;color:var(--sub);margin-bottom:7px;letter-spacing:1px}
.hstats{display:flex;gap:14px;margin-bottom:7px;flex-wrap:wrap}
.hs{font-size:11px;color:var(--txt)}
.hs b{font-family:'Unbounded',sans-serif;font-size:17px;font-weight:900}
.hsi b{color:var(--i)}.hsk b{color:var(--k)}.hsv b{color:var(--v)}
.hwa{font-size:11px;color:var(--sub);line-height:1.8;font-family:monospace}

/* Modal */
.mbg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.86);z-index:60;align-items:flex-end;justify-content:center}
.mbg.open{display:flex}
.modal{background:var(--s1);border:1px solid var(--rim2);border-radius:20px 20px 0 0;padding:20px 14px calc(var(--sb)+22px);width:100%;max-width:520px}
.mo-id{font-family:'Unbounded',sans-serif;font-size:38px;font-weight:900;color:var(--i);margin-bottom:3px}
.mo-nm{font-size:13px;font-weight:700;color:var(--txt);margin-bottom:2px}
.mo-ad{font-size:10px;color:var(--sub);margin-bottom:11px}
.mo-note{font-size:12px;color:var(--a);line-height:1.6;padding:11px;background:var(--a1);border-radius:9px;border:1px solid var(--a2);margin-bottom:13px}
.mo-sp-badge{font-size:11px;color:var(--y);background:var(--y1);border:1px solid var(--y2);border-radius:8px;padding:6px 12px;margin-bottom:12px;display:none}

/* Toast */
.toast{position:fixed;bottom:calc(var(--sb)+18px);left:50%;transform:translateX(-50%) translateY(80px);background:var(--i);color:#000;padding:11px 24px;border-radius:40px;font-size:12px;font-weight:700;z-index:100;transition:transform .3s cubic-bezier(.34,1.56,.64,1);white-space:nowrap;pointer-events:none}
.toast.show{transform:translateX(-50%) translateY(0)}
.hdiv{height:1px;background:var(--rim);margin:13px 0}
.gap{height:8px}
</style>
</head>
<body>
<div id="app">

<!-- HEADER -->
<div class="hdr">
  <div class="logo">T2 <b>Lausanne</b></div>
  <div class="pills">
    <span class="pill pi" id="b-i">i0</span>
    <span class="pill pk" id="b-k">k0</span>
    <span class="pill pv" id="b-v">v0</span>
    <span class="pill ps" id="b-stops">0 stops</span>
  </div>
</div>

<!-- TABS -->
<div class="tabs">
  <button class="tab on" onclick="go('cfg')">① Config</button>
  <button class="tab"    onclick="go('tour')">② Tournée</button>
  <button class="tab"    onclick="go('sum')">③ Résumé</button>
  <button class="tab"    onclick="go('hist')">Histo</button>
</div>

<!-- ① CONFIG -->
<div class="pg on" id="pg-cfg">

  <div class="lbl">Stops spéciaux K / V</div>
  <p class="hint">Sélectionner les stops qui peuvent avoir Kühne (K) ou LaborVets (V).</p>

  <div class="add-row">
    <input class="ni" id="sp-num" type="number" min="1" max="999" placeholder="N°" inputmode="numeric"/>
    <button class="btn bi" style="flex:1" onclick="addSpNum()">+ Stop</button>
    <button class="btn bs" id="grid-btn" onclick="toggleGrid()">Grille</button>
  </div>

  <div class="sp-grid" id="sp-grid"></div>

  <div class="sp-chips" id="sp-chips">
    <span style="font-size:11px;color:var(--sub)">Aucun stop spécial</span>
  </div>
  <button class="btn br" style="font-size:11px;height:36px;margin-top:8px;width:100%" onclick="clearAllSp()">🗑 Tout désélectionner</button>

  <div class="hdiv"></div>

  <div class="lbl">Tournée du jour (copier-coller)</div>
  <p class="hint">Coller la liste Excel ou WhatsApp — les numéros sont extraits automatiquement.</p>

  <textarea class="ta" id="ta-tour" rows="8"
    placeholder="TOUR    Position    N&#10;Tour 12-----    20&#10;Tour 12-----    70&#10;Tour 12-----    195&#10;Tour 12-----    280&#10;..."></textarea>

  <div class="dbox dbi" id="dbox-tour">
    <div class="dbox-ttl">Stops détectés</div>
    <div class="dtags" id="dtags-tour"></div>
  </div>

  <div class="brow" style="margin-top:9px">
    <button class="btn bs" style="flex:1" onclick="clearTour()">Effacer</button>
    <button class="btn bi" style="flex:2" onclick="confirmTour()">Démarrer →</button>
  </div>

  <div class="hdiv"></div>
  <button class="btn br bw" onclick="newTour()">🗑 Nouvelle tournée</button>
</div>

<!-- ② TOURNÉE -->
<div class="pg" id="pg-tour">

  <div class="done-banner" id="done-banner">
    <div>
      <div class="db-txt">✅ Tous les stops sont faits !</div>
      <div class="db-sub">Résumé WhatsApp prêt</div>
    </div>
    <button class="btn bi" onclick="go('sum')" style="flex-shrink:0">Résumé →</button>
